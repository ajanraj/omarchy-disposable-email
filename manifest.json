  "license": "MIT",
  "description": "Create temporary addresses and forwarding aliases from the Omarchy bar.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
